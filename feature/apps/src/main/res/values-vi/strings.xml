    <string name="bloat_back">Quay lại</string>
    <string name="bloat_intro">Các ứng dụng do nhà sản xuất cài sẵn và gỡ an toàn. Ứng dụng chỉ bị gỡ khỏi tài khoản của bạn: hệ thống vẫn giữ bản gốc nên bạn có thể khôi phục tại đây bất cứ lúc nào.</string>
    <string name="bloat_recommended">Khuyên gỡ</string>
    <string name="bloat_removed">Đã gỡ hoặc đã tắt</string>
    <string name="bloat_none">Không còn gì để gỡ. Máy bạn đã gọn gàng.</string>
    <string name="bloat_unused">Ứng dụng cài sẵn bạn không bao giờ mở</string>
    <string name="bloat_unused_hint">Tìm theo cách bạn dùng máy nên áp dụng cho mọi hãng. Đã loại trừ đồng hồ, lịch, email, camera, thư viện ảnh, trình duyệt, kho ứng dụng và app đang làm việc ngầm. Một số app vẫn hoạt động dù không mở (sao lưu, đồng hồ thông minh, xe hơi): chỉ tắt app bạn biết rõ. Có thể bật lại bằng nút Khôi phục bên dưới.</string>
    <string name="bloat_unused_needs_usage">Hãy cấp quyền truy cập dữ liệu sử dụng trong Cài đặt để tìm app cài sẵn bạn không dùng.</string>
